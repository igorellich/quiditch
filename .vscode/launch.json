{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Docker",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/server",
      "remoteRoot": "/app/server",
      "sourceMaps": true,
      "outFiles": ["/app/server/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "/app/server/dist/**"
      ],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}